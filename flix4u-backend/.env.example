# Flix4U backend environment template
# Copy to .env locally; set these in Vercel project settings for deployment.
# No Firebase credentials are required in guest mode.

# Guest mode is hardcoded as permanent in server.ts. This value is ignored.
# PUBLIC_GUEST_MODE=1

# Long random secret used to sign guest stream-session cookies across Vercel instances.
STREAM_PROXY_SECRET=replace-with-a-long-random-secret

# Optional admin token if you later expose admin routes. Leave blank to keep admin disabled.
ADMIN_TOKEN=

# App origin for CORS, comma-separated if multiple.
APP_URL=http://localhost:3000

# Anime upstreams already supported by the inherited backend.
VITE_STREAMING_API_BASE=https://ashanime-api.vercel.app
VITE_ANILIST_API_URL=https://graphql.anilist.co
CONSUMET_API_URL=https://consumet-public.vercel.app
ANIMEWORLD_UPSTREAM_URL=https://animesky.app
ANIMEWORLD_INDIA_API_URL=

# Metadata for movies and web series.
TMDB_API_KEY=replace-with-your-tmdb-api-key

# Scraper tuning.
CACHE_TTL_MINUTES=30
SCRAPER_TIMEOUT_MS=7000

# Optional hosted PHP scraper for AnimeWorld India.
# ANIMEWORLD_INDIA_API_URL=https://your-php-host.example.com/api
