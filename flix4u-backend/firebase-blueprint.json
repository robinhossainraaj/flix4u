        "commentsCount": { "type": "number", "minimum": 0 },
        "reported": { "type": "boolean" },
        "reportsCount": { "type": "number", "minimum": 0 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorUid", "authorName", "authorAvatar", "content", "likesCount", "likedBy", "commentsCount", "reported", "reportsCount", "createdAt", "updatedAt"]
    },
    "CommunityComment": {
      "title": "CommunityComment",
      "description": "User reply/comment on a CommunityPost.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "postId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "authorAvatar": { "type": "string", "maxLength": 500 },
        "authorFrame": { "type": "string", "maxLength": 40 },
        "content": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "authorUid", "authorName", "authorAvatar", "content", "createdAt"]
    }
