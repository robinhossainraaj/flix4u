{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user streaming preferences, profile display info, and activity timestamps.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "bannerURL": {
          "type": "string",
          "maxLength": 500
        },
        "preferredAudio": {
          "type": "string",
          "enum": ["sub", "dub", "hindi"]
        },
        "autoNext": {
          "type": "boolean"
        },
        "lastActiveDay": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "lastActiveAt": {
          "type": "string",
          "format": "date-time"
        },
        "theme": {
          "type": "string",
          "enum": ["midnight-purple", "deep-black", "ocean-blue", "crimson-red", "emerald-green", "rose-pink", "amoled-black"]
        },
        "streakCurrent": {
          "type": "number",
          "minimum": 0
        },
        "streakLongest": {
          "type": "number",
          "minimum": 0
        },
        "streakLastWatchedDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "streakWatchedDays": {
          "type": "array",
          "items": { "type": "string", "maxLength": 10 },
          "maxItems": 400
        },
        "totalEpisodesCompleted": {
          "type": "number",
          "minimum": 0
        },
        "todayEpisodesCompleted": {
          "type": "number",
          "minimum": 0
        },
        "todayCompletedDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "totalWatchSeconds": {
          "type": "number",
          "minimum": 0
        },
        "todayWatchSeconds": {
          "type": "number",
          "minimum": 0
        },
        "todayWatchDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "watchedAnimeIds": {
          "type": "array",
          "items": { "type": "string", "maxLength": 120 },
          "maxItems": 500
        },
        "unlockedAchievements": {
          "type": "array",
          "items": { "type": "string", "maxLength": 40 },
          "maxItems": 30
        },
        "achievementUnlockDates": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 40 }
        },
        "equippedBadges": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "first_watch",
              "streak_3",
              "streak_7",
              "streak_30",
              "streak_100",
              "anime_explorer",
              "anime_master",
              "anime_legend",
              "binge_watcher",
              "marathon_legend"
            ],
            "maxLength": 40
          },
          "maxItems": 5
        },
        "xp": {
          "type": "number",
          "minimum": 0
        },
        "level": {
          "type": "number",
          "minimum": 1
        },
        "lastLoginXpDay": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "lastGoalXpDay": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "xpStreakMilestones": {
          "type": "array",
          "items": { "type": "number" },
          "maxItems": 10
        },
        "xpUpdatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "equippedFrame": {
          "type": "string",
          "maxLength": 40
        },
        "checkinStreak": {
          "type": "number",
          "minimum": 0
        },
        "lastCheckinDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "totalCheckins": {
          "type": "number",
          "minimum": 0
        },
        "coins": {
          "type": "number",
          "minimum": 0
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "preferredAudio", "autoNext", "createdAt", "updatedAt"]
    },
    "ProfileBanner": {
      "title": "ProfileBanner",
      "description": "Admin-managed and unlockable profile header banner.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "imageUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "enabled": {
          "type": "boolean"
        },
        "isLocked": {
          "type": "boolean"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "category",
        "imageUrl",
        "enabled",
        "isLocked",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "CustomizationSettings": {
      "title": "CustomizationSettings",
      "description": "Global unlock settings for profile banners and avatars.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": ["global"]
        },
        "globalBannersUnlocked": {
          "type": "boolean"
        },
        "globalAvatarsUnlocked": {
          "type": "boolean"
        },
        "lockedBannerIds": {
          "type": "array",
          "items": { "type": "string", "maxLength": 128 },
          "maxItems": 500
        },
        "lockedAvatarIds": {
          "type": "array",
          "items": { "type": "string", "maxLength": 128 },
          "maxItems": 500
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "globalBannersUnlocked",
        "globalAvatarsUnlocked",
        "lockedBannerIds",
        "lockedAvatarIds",
        "updatedBy",
        "updatedAt"
      ]
    },
    "PopupBanner": {
      "title": "PopupBanner",
      "description": "Admin-managed promotional or announcement popup banner shown on Flix4U.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "imageUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "buttonText": {
          "type": "string",
          "maxLength": 60
        },
        "destinationUrl": {
          "type": "string",
          "maxLength": 500
        },
        "openInNewTab": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "startAt": {
          "type": "string",
          "maxLength": 40
        },
        "expiresAt": {
          "type": "string",
          "maxLength": 40
        },
        "frequency": {
          "type": "string",
          "enum": ["once_per_session", "once_per_day", "once_per_user", "always_on_launch"]
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "imageUrl",
        "openInNewTab",
        "enabled",
        "frequency",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
